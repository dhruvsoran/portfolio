# Copy to .env and fill in your real values.
# This file IS committed to the repo (only .env is ignored).

# ─── Server ──────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production
# Optional: canonical origin used in outbound email links.
PUBLIC_URL=https://dhruvsoran.com

# ─── Inbox (contact form submissions) ───────────────────────────────────
# Leave blank in development = inbox endpoints are open.
# Set a non-empty value to require ?key=… or x-inbox-key header.
INBOX_KEY=change-me-to-a-long-random-string

# ─── OpenAI TTS (intro audio) ───────────────────────────────────────────
# Get a key at https://platform.openai.com/api-keys ($5 free credit for new accounts).
# OPENAI_API_KEY=

# Voice options: alloy, echo, fable, onyx, nova, shimmer
# TTS_VOICE=onyx
# TTS_MODEL=tts-1-hd
# TTS_SPEED=0.95

# ─── ElevenLabs TTS (premium, optional) ────────────────────────────────
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE=pNInz6obpgDQGcFmaJgB

# ─── Gmail SMTP (contact form email forwarding) ────────────────────────
# 1. Enable 2-Step Verification on the Gmail account.
# 2. Create an App Password at https://myaccount.google.com/apppasswords
# 3. Paste the 16-character password below (no spaces).
# Leave both blank to disable email forwarding (submissions still save to inbox.json).
# MAIL_USER=dhruvsoran@gmail.com
# MAIL_PASS=
# MAIL_TO=dhruvsoran@gmail.com
# MAIL_FROM="Dhruv Soran Site <dhruvsoran@gmail.com>"
